# Copy to .env, then set the same signing secret used by slayd24-ai.
JWT_SECRET_KEY=

# Docker publishes only on loopback by default. Put a TLS reverse proxy in front.
MCP_BIND_ADDRESS=127.0.0.1
MCP_PUBLIC_PORT=8000

# Set these only after slayd24-ai includes iss/aud in its JWTs.
MCP_JWT_ISSUER=
MCP_JWT_AUDIENCE=
